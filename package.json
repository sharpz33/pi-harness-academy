    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run deploy -- --dry-run"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.110.0"
  }
}
