{
  "name": "pi-harness-academy",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy --minify --env=\"\"",
    "cf-typegen": "wrangler types --env local --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run deploy -- --dry-run"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.110.0"
  }
}
