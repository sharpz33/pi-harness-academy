{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-harness-academy",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "env": {
    "local": {
      "name": "pi-harness-academy-local",
      "vars": {
        "APP_ORIGIN": "http://localhost:8787",
        "AUTH_FROM": "login@local.invalid"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pi-harness-academy-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ]
    }
  }
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
